---
import Layout from '../layouts/Layout.astro';

const zeffyUrl = 'https://www.zeffy.com/en-GB/organizations/manchester-select';
const christieCupUrl = 'https://www.zeffy.com/en-GB/donation-form/christie-cup-donations';
const christieCupImage = '/christie-cup.png';
const apiBase = 'https://api.zeffy.com/api/v1';
const apiKey = import.meta.env.ZEFFY_API_KEY || '';

type Campaign = {
  id?: string;
  title?: string;
  name?: string;
  description?: string;
  slug?: string;
  url?: string;
  campaign_url?: string;
  type?: string;
  status?: string;
  start_date?: string;
  end_date?: string;
  starts_at?: string;
  ends_at?: string;
  image_url?: string;
  cover_image_url?: string;
  location?: string | { name?: string; address?: string };
};

const manualChristieCup: Campaign = {
  id: 'christie-cup-manual',
  title: 'Christie Cup',
  description: 'Cricket T20 match supporting The Christie Charity. Family fun day with live DJ, bouncy castle and artisan stalls.',
  url: christieCupUrl,
  type: 'event',
  start_date: '2026-09-13T11:00:00+01:00',
  location: 'Staley Cricket Club, SK15 3JJ',
};

const parseDate = (value?: string) => {
  if (!value) return null;
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? null : date;
};

const getEvents = async (): Promise<Campaign[]> => {
  if (!apiKey) return [manualChristieCup];

  const headers = { Authorization: `Bearer ${apiKey}` };
  const campaigns: Campaign[] = [];
  let cursor = '';

  for (let page = 0; page < 10; page += 1) {
    const url = new URL(`${apiBase}/campaigns`);
    if (cursor) url.searchParams.set('cursor', cursor);
    const response = await fetch(url, { headers });
    if (!response.ok) throw new Error(`Zeffy API returned ${response.status}`);

    const payload = await response.json();
    const batch = Array.isArray(payload) ? payload : payload.data || payload.campaigns || [];
    campaigns.push(...batch);

    if (!payload.has_more || !payload.next_cursor) break;
    cursor = payload.next_cursor;
  }

  const now = new Date();
  return campaigns
    .filter((campaign) => {
      const type = (campaign.type || '').toLowerCase();
      const start = parseDate(campaign.start_date || campaign.starts_at || campaign.end_date || campaign.ends_at);
      return (!type || type.includes('event')) && (!start || start >= now);
    })
    .sort((a, b) => {
      const aDate = parseDate(a.start_date || a.starts_at || a.end_date || a.ends_at)?.getTime() || Number.MAX_SAFE_INTEGER;
      const bDate = parseDate(b.start_date || b.starts_at || b.end_date || b.ends_at)?.getTime() || Number.MAX_SAFE_INTEGER;
      return aDate - bDate;
    });
};

let events: Campaign[] = [];
let errorMessage = '';

try {
  events = await getEvents();
} catch (error) {
  console.error(error);
  errorMessage = 'We could not load the live event list right now.';
}

const formatDate = (value?: string) => {
  const date = parseDate(value);
  if (!date) return 'Date to be confirmed';
  return new Intl.DateTimeFormat('en-GB', {
    weekday: 'short',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};

const formatTime = (value?: string) => {
  const date = parseDate(value);
  if (!date) return '';
  return new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit' }).format(date);
};

const getLocation = (event: Campaign) => {
  if (typeof event.location === 'string') return event.location;
  if (event.location?.name) return event.location.name;
  if (event.location?.address) return event.location.address;
  return 'Manchester';
};

const getUrl = (event: Campaign) => event.url || event.campaign_url || (event.slug ? `https://www.zeffy.com/en-GB/ticketing/${event.slug}` : zeffyUrl);
const getTitle = (event: Campaign) => event.title || event.name || 'Manchester Select event';
const getImage = (event: Campaign) => event.cover_image_url || event.image_url || (event.id === manualChristieCup.id ? christieCupImage : undefined);
---

<Layout
  title="Upcoming Events | Manchester Select"
  description="See every upcoming Manchester Select event, with dates, locations and registration links from our Zeffy organisation page."
>
  <section class="events-hero">
    <div class="container">
      <div class="eyebrow">Manchester Select</div>
      <div class="hero-row">
        <div>
          <h1>Upcoming events.</h1>
          <p class="hero-copy">Every upcoming Manchester Select event in one place, kept in sync with our Zeffy organisation page.</p>
        </div>
        <a class="button button-accent" href={zeffyUrl} target="_blank" rel="noreferrer">View on Zeffy ↗</a>
      </div>
    </div>
  </section>

  <section class="section events-section">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">What’s next</div>
          <h2>Save the dates.</h2>
        </div>
        <p class="lead">Sport, community and fundraising — with tickets and registration handled directly through Zeffy.</p>
      </div>

      {errorMessage ? (
        <div class="empty-state">
          <strong>{errorMessage}</strong>
          <p>Please use the Zeffy page for the latest event information.</p>
          <a class="button button-dark" href={zeffyUrl} target="_blank" rel="noreferrer">Open Zeffy events</a>
        </div>
      ) : events.length === 0 ? (
        <div class="empty-state">
          <strong>No upcoming events are currently listed.</strong>
          <p>Check back soon or browse the live Manchester Select page on Zeffy.</p>
          <a class="button button-dark" href={zeffyUrl} target="_blank" rel="noreferrer">Open Zeffy events</a>
        </div>
      ) : (
        <div class="event-list">
          {events.map((event) => {
            const start = event.start_date || event.starts_at;
            const end = event.end_date || event.ends_at;
            const image = getImage(event);
            return (
              <article class="live-event">
                <div class="date-block">
                  <span>{start ? formatDate(start).split(' ')[0] : 'Next'}</span>
                  <strong>{parseDate(start)?.getDate() || '—'}</strong>
                  <small>{parseDate(start) ? new Intl.DateTimeFormat('en-GB', { month: 'short' }).format(parseDate(start)!) : ''}</small>
                </div>
                {image ? <img src={image} alt={`${getTitle(event)} event artwork`} loading="lazy" /> : <div class="image-placeholder">Manchester Select</div>}
                <div class="event-content">
                  <div class="event-meta">
                    <span>{formatDate(start)}</span>
                    {formatTime(start) && <span>{formatTime(start)}{end && formatTime(end) ? `–${formatTime(end)}` : ''}</span>}
                  </div>
                  <h3>{getTitle(event)}</h3>
                  {event.description && <p>{event.description}</p>}
                  <div class="event-location">{getLocation(event)}</div>
                </div>
                <a class="button button-dark" href={getUrl(event)} target="_blank" rel="noreferrer">Tickets / details ↗</a>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-card">
      <div>
        <div class="eyebrow">Stay in the loop</div>
        <h2>Miss nothing.</h2>
        <p>For the authoritative event listing, registration and ticket availability, visit Manchester Select on Zeffy.</p>
      </div>
      <a class="button button-accent" href={zeffyUrl} target="_blank" rel="noreferrer">Go to Zeffy ↗</a>
    </div>
  </section>

  <style>
    .events-hero{background:var(--navy);color:#fff;padding:96px 0 84px}.hero-row{display:flex;justify-content:space-between;align-items:end;gap:40px}.events-hero h1{font-size:clamp(4rem,9vw,7.5rem);line-height:.86;letter-spacing:-.07em;margin:0 0 25px}.hero-copy{max-width:610px;color:#d4dde2;font-size:1.15rem}.events-section{background:#f0eee8}.event-list{display:grid;gap:16px}.live-event{display:grid;grid-template-columns:92px 240px 1fr auto;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px;overflow:hidden}.live-event img,.image-placeholder{width:240px;height:170px;object-fit:contain;border-radius:14px;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:900}.date-block{text-align:center;border-right:1px solid var(--line);padding:8px 15px}.date-block span{display:block;font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:#6c7881;font-weight:900}.date-block strong{display:block;font-size:2.8rem;line-height:1;font-weight:950;letter-spacing:-.06em}.date-block small{display:block;font-weight:900;text-transform:uppercase}.event-meta{display:flex;gap:14px;flex-wrap:wrap;color:#697680;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;font-weight:900}.event-content h3{font-size:2rem;line-height:1;margin:10px 0}.event-content p{margin:0 0 12px;color:#67747e;max-width:650px}.event-location{font-weight:900;color:#17232d}.empty-state{padding:55px;background:#fff;border:1px solid var(--line);border-radius:20px}.empty-state strong{display:block;font-size:1.5rem;margin-bottom:8px}.empty-state p{color:#67747e;margin:0 0 22px}.cta-section{background:#fff}.cta-card{background:var(--navy);color:#fff;border-radius:28px;padding:50px;display:flex;justify-content:space-between;align-items:center;gap:30px}.cta-card h2{font-size:clamp(3rem,6vw,5rem);line-height:.9;letter-spacing:-.06em;margin:0 0 12px}.cta-card p{color:#cfd9de;max-width:650px;margin:0}.eyebrow{font-weight:950;text-transform:uppercase;letter-spacing:.12em;font-size:.7rem;margin-bottom:14px}@media (max-width:1000px){.live-event{grid-template-columns:80px 190px 1fr}.live-event .button{grid-column:3}.live-event img,.image-placeholder{width:190px;height:150px}}@media (max-width:760px){.hero-row,.cta-card{display:block}.hero-row .button,.cta-card .button{margin-top:25px}.live-event{grid-template-columns:72px 1fr;gap:16px}.live-event img,.image-placeholder{grid-column:2;width:100%;height:190px;order:2}.live-event .event-content{grid-column:2;order:3}.live-event .button{grid-column:2;order:4;justify-self:start}.date-block{grid-row:1 / span 1;border-right:0;border-bottom:1px solid var(--line);padding-bottom:14px}.event-content h3{font-size:1.6rem}.cta-card{padding:34px}}
  </style>
</Layout>
