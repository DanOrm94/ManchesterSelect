---
import Layout from '../layouts/Layout.astro';
const raw='https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/';
const sports=[
  ['Rugby League','The sport that started it all. Charity matches, tournaments and the community that made Manchester Select possible.','event10.png','/our-story'],
  ['Women’s Sport','More fixtures. More opportunities. Our women’s events help make Manchester Select a wider, more inclusive sporting community.','event5.png','/#contact'],
  ['Football','New teams, new opportunities and another way for local people to use sport to support a cause that matters.','event7.png','/#contact'],
  ['More to come','We want to welcome more sports, clubs and communities. If you have an idea for an event, we want to hear it.','teamphoto.png','/#contact'],
];
---
<Layout title="Sports | Manchester Select" description="Manchester Select uses sport to bring people together, raise money for The Christie and build stronger communities.">
  <section class="sport-hero"><div class="container"><div class="eyebrow">Sport for good</div><h1>More sports.<br/><span>More impact.</span></h1><p class="lead">Manchester Select started with rugby league. The next chapter is bigger — bringing different sports, teams and communities together to raise money for The Christie.</p></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Find your sport</div><h2>Everyone has a place here.</h2></div><p class="lead" style="max-width:400px">Whether you're a player, coach, supporter, volunteer or business, sport gives us a reason to get together and do something positive.</p></div><div class="sports-grid">{sports.map((sport,index)=><article class:list={['sport-card',index===0&&'sport-card-large']}><img src={raw+sport[2]} alt={sport[0]+' at Manchester Select'} loading="lazy"/><div class="sport-card-overlay"><div class="eyebrow">{index===0?'The original':index===3?'The future':'Manchester Select'}</div><h3>{sport[0]}</h3><p>{sport[1]}</p><a class="button button-accent" href={sport[3]}>{index===0?'Our story':'Get involved'}</a></div></article>)}</div></div></section>
  <section class="impact-band section"><div class="container sports-purpose"><div><div class="eyebrow">The purpose</div><h2>Sport is the vehicle.<br/>Community is the engine.</h2></div><div><p class="lead" style="color:#d2dbe0">Every event is designed to do more than fill a fixture list. We want people to meet, play, support each other and help raise money for The Christie.</p><a class="button button-accent" href="/#contact">Bring your sport to Manchester Select</a></div></div></section>
  <section class="section"><div class="container next-chapter"><div class="eyebrow">The next chapter</div><h2>We're only getting started.</h2><div class="chapter-grid"><div><strong>01</strong><h3>More events</h3><p>Build a calendar of sporting events that keep fundraising moving throughout the year.</p></div><div><strong>02</strong><h3>More sports</h3><p>Open Manchester Select to new sporting communities beyond rugby league.</p></div><div><strong>03</strong><h3>More people</h3><p>Give players, families, volunteers and businesses more ways to get involved.</p></div></div></div></section>
  <style>
    .sport-hero{background:var(--navy);color:#fff;padding:170px 0 105px}.sport-hero h1{font-size:clamp(4.5rem,10vw,9rem);line-height:.82;letter-spacing:-.08em;margin:0 0 35px}.sport-hero h1 span{color:var(--accent)}.sport-hero .lead{max-width:700px;color:#d3dce1}.sports-grid{display:grid;grid-template-columns:1.5fr 1fr;grid-auto-rows:380px;gap:16px}.sport-card{position:relative;overflow:hidden;border-radius:24px;background:var(--navy);color:#fff}.sport-card-large{grid-row:span 2}.sport-card>img{width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform .5s}.sport-card:hover>img{transform:scale(1.05)}.sport-card-overlay{position:absolute;inset:auto 0 0;padding:30px;background:linear-gradient(transparent,rgba(0,0,0,.92))}.sport-card h3{font-size:clamp(2rem,4vw,3.5rem);line-height:.9;margin:5px 0 12px}.sport-card p{max-width:560px;color:#d3dce1}.sports-purpose{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.sports-purpose h2{font-size:clamp(3rem,6vw,5.5rem);line-height:.9;letter-spacing:-.06em}.next-chapter h2{font-size:clamp(3.5rem,8vw,7rem);line-height:.86;margin:15px 0 55px}.chapter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(7,18,29,.18)}.chapter-grid>div{background:#d9f24f;padding:30px 24px;min-height:230px}.chapter-grid strong{color:#617800;font-weight:950}.chapter-grid h3{font-size:1.7rem;margin:35px 0 5px}.chapter-grid p{color:#3e4c57}@media(max-width:900px){.sports-grid{grid-template-columns:1fr;grid-auto-rows:340px}.sport-card-large{grid-row:auto}.sports-purpose{grid-template-columns:1fr;gap:20px}.chapter-grid{grid-template-columns:1fr}}@media(max-width:560px){.sport-hero{padding:130px 0 75px}.sport-hero h1{font-size:4.5rem}.sport-card-overlay{padding:22px}}
  </style>
</Layout>
