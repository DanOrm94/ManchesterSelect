---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
const raw = 'https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const tiers = [
  ['Large Shirt / Tournament Sponsorship','£1,000','Premium visibility across the tournament and event materials.'],
  ['Ball Sponsorship','£500','Put your business at the heart of the matchday experience.'],
  ['Small Shirt Sponsor','£400','A visible sponsor position on the playing kit.'],
  ['Shorts Sponsorship','£250','Support the squad with a branded matchday position.'],
  ['Player Sponsorship','£50','Back an individual player and become part of their journey.'],
];
---
<Layout title="Manchester Select | Proud Sponsors of The Christie charity" description="Manchester Select is a community rugby league charity raising money for The Christie through sporting events.">
  <section class="hero">
    <div class="hero-content">
      <div class="eyebrow">Manchester Select Charity</div>
      <h1>More than a match.</h1>
      <p class="hero-copy">A community club built around rugby league, big-hearted events and one simple purpose: raising money for The Christie.</p>
      <div class="actions"><a class="button button-accent" href="#our-story">Our Story</a><a class="button button-light" href="#contact">Get Involved</a></div>
    </div>
  </section>

  <section class="christie section-tight">
    <div class="container christie-inner">
      <div class="christie-logo"><img src={raw + 'Supporting-The-Christie-Charity.jpg'} alt="Manchester Select supporting The Christie charity" /></div>
      <div><div class="eyebrow" style="color:#61707d">Our charity partner</div><h2>Proud Sponsors of The Christie charity.</h2><p class="lead">Manchester Select exists to turn the energy of sport into something bigger. Every event brings players, families, supporters and businesses together to help raise funds for The Christie, one of Europe’s leading cancer centres.</p><a class="button button-dark" href="#impact">See our impact</a></div>
    </div>
  </section>

  <section id="our-story" class="section">
    <div class="container story-grid"><div><div class="eyebrow">Where it started</div><h2>A diagnosis became a reason to bring people together.</h2><p class="lead">Manchester Select grew from a personal story and a shared love of rugby league. Sarah’s diagnosis, and the motivation of Chris and Nick to do something positive, became the spark for an event that could raise money while creating an unforgettable day for the community.</p><p class="lead">That first idea became a real fixture, bringing elite and community players together in Manchester. The ambition is now bigger: more events, more sports, more people involved and more money raised for causes that matter.</p><a class="button button-dark" href="/our-story">Read our full story</a></div><div class="story-photo"><img src={raw + 'event1.png'} alt="Manchester Select players and supporters at a charity event" loading="lazy" /></div></div>
  </section>

  <section id="impact" class="impact-band section-tight"><div class="container"><div class="eyebrow">What sport can do</div><div class="impact-grid"><div class="impact-stat"><strong>£85k+</strong><span>Raised for The Christie through Manchester Select events.</span></div><div class="impact-stat"><strong>1,400</strong><span>Approximate spectators welcomed across our first two events.</span></div><div class="impact-stat"><strong>2</strong><span>Major charity events that created the foundation for what comes next.</span></div></div></div></section>

  <section id="events" class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Event recap</div><h2>One match. A whole community.</h2></div><p class="lead" style="max-width:380px">September 2024 brought Manchester Select to life with a charity match against Great Britain Police, alongside a women’s fixture against Keighley Cougars.</p></div><div class="event-grid"><article class="event-feature"><img src={raw + 'event10.png'} alt="Manchester Select charity rugby event" loading="lazy" /><div class="event-overlay"><div class="eyebrow">September 2024</div><h3>Manchester Select vs Great Britain Police</h3><p>Competitive rugby league with a bigger purpose.</p></div></article><div class="event-stack"><article class="event-card"><img src={raw + 'event5.png'} alt="Women's rugby league charity fixture" loading="lazy" /><div class="event-overlay"><div class="eyebrow">Women’s fixture</div><h3>Keighley Cougars</h3></div></article><article class="event-card"><img src={raw + 'etihadshot.png'} alt="Manchester skyline and event location" loading="lazy" /><div class="event-overlay"><div class="eyebrow">Manchester</div><h3>Sport. Community. Purpose.</h3></div></article></div></div><div class="partner-row"><div class="partner">MANCHESTER CITY<br/><small>community partner</small></div><div class="partner">LEEDS RHINOS<br/><small>rugby partner</small></div><div class="partner">TESCO<br/><small>supporting partner</small></div><div class="partner"><img src={raw + 'cityrecruiter.png'} alt="City Recruiter" /></div></div></div></section>

  <section class="section" style="background:#fff"><div class="container"><div class="section-head"><div><div class="eyebrow">The moments</div><h2>Real people. Real events.</h2></div><p class="lead" style="max-width:360px">These are the moments behind the numbers — players, families, volunteers and supporters making Manchester Select happen.</p></div><Gallery /></div></section>

  <section id="sponsorship" class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Support the next event</div><h2>Put your brand behind the cause.</h2></div><p class="lead" style="max-width:370px">Choose a sponsorship level and help us fund the next Manchester Select event. Every package contributes to our fundraising mission.</p></div><div class="sponsor-grid">{tiers.map((tier,index)=><article class:list={['sponsor-card', index===0 && 'featured']}><div class="eyebrow">Manchester Select</div><h3>{tier[0]}</h3><div class="price">{tier[1]}</div><p>{tier[2]}</p><a class="button" class:button-accent={index===0} class:button-dark={index!==0} href="#contact">Enquire</a></article>)}</div></div></section>

  <section id="contact" class="contact section"><div class="container story-grid"><div><div class="eyebrow">Get involved</div><h2>Bring your business, team or energy.</h2><p class="lead">Interested in sponsorship, volunteering, playing or partnering with Manchester Select? Send us a message and we’ll get back to you.</p><p class="form-note">Your enquiry is protected by Cloudflare Turnstile. We never sell your information.</p></div><form class="form-grid" method="post" action="/api/contact"><div class="field"><label for="name">Name</label><input id="name" name="name" required autocomplete="name" /></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required autocomplete="email" /></div><div class="field"><label for="tier">Interested in</label><select id="tier" name="tier"><option value="">Choose a sponsorship tier</option>{tiers.map((tier)=><option value={tier[0]}>{tier[0]} — {tier[1]}</option>)}<option value="Other">Something else</option></select></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" required></textarea></div><div class="field full"><div class="cf-turnstile" data-sitekey={turnstileKey}></div><input type="hidden" name="turnstile_token" id="turnstile-token" /><button class="button button-dark" type="submit">Send enquiry</button></div></form></div></section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Layout>
