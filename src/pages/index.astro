---
import Layout from '../layouts/Layout.astro';
import Gallery from '../components/Gallery.astro';
const raw = 'https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const tiers = [
  ['Large Shirt / Tournament Sponsorship','£1,000','Premium visibility across the tournament and event materials.'],
  ['Ball Sponsorship','£500','Put your business at the heart of the matchday experience.'],
  ['Small Shirt Sponsor','£400','A visible sponsor position on the playing kit.'],
  ['Shorts Sponsorship','£250','Support the squad with a branded matchday position.'],
  ['Player Sponsorship','£50','Back an individual player and become part of their journey.'],
];
const sports=[['Rugby League','The sport that started it all.','event10.png'],['Women’s Sport','More fixtures. More opportunities.','event5.png'],['Football','New teams. New opportunities.','event7.png'],['More to come','More sports. More fundraising.','teamphoto.png']];
---
<Layout title="Manchester Select | Proud Sponsors of The Christie charity" description="Manchester Select is a community sports charity using events to bring people together and raise money for The Christie.">
  <section class="hero"><div class="hero-content"><div class="eyebrow">Manchester Select Charity</div><h1>More than a match.</h1><p class="hero-copy">A community club built around sport, big-hearted events and one simple purpose: raising money for The Christie.</p><div class="actions"><a class="button button-accent" href="#our-story">Our Story</a><a class="button button-light" href="#contact">Get Involved</a></div><div class="hero-stats"><span>£85,000+ raised</span><i></i><span>1,400+ spectators</span><i></i><span>2 major events</span></div></div></section>
  <section class="christie section-tight"><div class="container christie-inner"><div class="christie-logo"><img src={raw + 'Supporting-The-Christie-Charity.jpg'} alt="Manchester Select supporting The Christie charity" /></div><div><div class="eyebrow" style="color:#61707d">Our charity partner</div><h2>Proud Sponsors of The Christie charity.</h2><p class="lead">Manchester Select exists to turn the energy of sport into something bigger. Every event brings players, families, supporters and businesses together to help raise funds for The Christie, one of Europe’s leading cancer centres.</p><a class="button button-dark" href="#impact">See our impact</a></div></div></section>
  <section id="our-story" class="section"><div class="container story-grid"><div><div class="eyebrow">Where it started</div><h2>A diagnosis became a reason to bring people together.</h2><p class="lead">Manchester Select grew from a personal story and a shared love of rugby league. Sarah’s diagnosis, and the motivation of Chris and Nick to do something positive, became the spark for an event that could raise money while creating an unforgettable day for the community.</p><p class="lead">That first idea became a real fixture, bringing elite and community players together in Manchester. The ambition is now bigger: more events, more sports, more people involved and more money raised for causes that matter.</p><a class="button button-dark" href="/our-story">Read our full story</a></div><div class="story-photo"><img src={raw + 'event1.png'} alt="Manchester Select players and supporters at a charity event" loading="lazy" /></div></div></section>
  <section id="impact" class="impact-band section-tight"><div class="container"><div class="eyebrow">What sport can do</div><div class="impact-grid"><div class="impact-stat"><strong data-count="85000">£85k+</strong><span>Raised for The Christie through Manchester Select events.</span></div><div class="impact-stat"><strong data-count="1400">1,400</strong><span>Approximate spectators welcomed across our first two events.</span></div><div class="impact-stat"><strong data-count="2">2</strong><span>Major charity events that created the foundation for what comes next.</span></div></div></div></section>
  <section class="section sport-preview"><div class="container"><div class="section-head"><div><div class="eyebrow">Beyond rugby</div><h2>More sports.<br/>More impact.</h2></div><p class="lead" style="max-width:390px">Rugby league started Manchester Select. Our future is about opening the door to more sports, teams and communities.</p></div><div class="sport-preview-grid">{sports.map((sport,index)=><a class:list={['sport-preview-card',index===0&&'sport-preview-featured']} href="/sports"><img src={raw+sport[2]} alt={sport[0]} loading="lazy"/><div><span>{sport[0]}</span><small>{sport[1]}</small></div></a>)}</div><a class="button button-dark" href="/sports">Explore all sports</a></div></section>
  <section class="impact-story"><div class="impact-story-number">£79,484</div><div class="impact-story-copy"><div class="eyebrow">29 September 2024</div><h2>One day.<br/>Almost 1,000 people.<br/>One incredible result.</h2><p>The first Manchester Select event turned a charity rugby match into a community movement. The final fundraising total was an extraordinary £79,484.</p><a class="button button-accent" href="/our-story">Read the full story</a></div></section>
  <section class="section people-section"><div class="container"><div class="section-head"><div><div class="eyebrow">The people</div><h2>People make the difference.</h2></div><p class="lead" style="max-width:390px">Manchester Select is powered by people who decided to turn a difficult experience into something positive.</p></div><div class="people-grid"><article><span>01</span><h3>Sarah</h3><p>The story that gave Manchester Select its purpose.</p></article><article><span>02</span><h3>Chris</h3><p>A shared motivation to create something meaningful through sport.</p></article><article><span>03</span><h3>Nick</h3><p>The idea behind the first charity rugby match and the spark that started it all.</p></article><article><span>04</span><h3>Everyone</h3><p>Players, families, volunteers, sponsors and supporters who make every event possible.</p></article></div></div></section>
  <section id="events" class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Event recap</div><h2>One match. A whole community.</h2></div><p class="lead" style="max-width:380px">September 2024 brought Manchester Select to life with a charity match against Great Britain Police, alongside a women’s fixture against Keighley Cougars.</p></div><div class="event-grid"><article class="event-feature"><img src={raw + 'event10.png'} alt="Manchester Select charity rugby event" loading="lazy"/><div class="event-overlay"><div class="eyebrow">September 2024</div><h3>Manchester Select vs Great Britain Police</h3><p>Competitive rugby league with a bigger purpose.</p></div></article><div class="event-stack"><article class="event-card"><img src={raw + 'event5.png'} alt="Women's rugby league charity fixture" loading="lazy"/><div class="event-overlay"><div class="eyebrow">Women’s fixture</div><h3>Keighley Cougars</h3></div></article><article class="event-card"><img src={raw + 'teamphoto.png'} alt="Manchester Select team" loading="lazy"/><div class="event-overlay"><div class="eyebrow">Manchester Select</div><h3>Sport. Community. Purpose.</h3></div></article></div></div><div class="partner-wall"><div class="eyebrow">Powered by our community</div><div class="partner-row"><div class="partner"><img src={raw + 'Manchester_City_FC_badge.png'} alt="Manchester City Football Club"/></div><div class="partner"><img src={raw + 'leeds-rhino.jpg'} alt="Leeds Rhinos"/></div><div class="partner"><img src={raw + 'tesco.png'} alt="Tesco"/></div><div class="partner"><img src={raw + 'cityrecruiter.png'} alt="City Recruiter"/></div></div><p>Want your business to be part of the next chapter? <a href="#contact">Become a partner →</a></p></div></div></section>
  <section class="section" style="background:#fff"><div class="container"><div class="section-head"><div><div class="eyebrow">The moments</div><h2>Real people. Real events.</h2></div><p class="lead" style="max-width:360px">These are the moments behind the numbers — players, families, volunteers and supporters making Manchester Select happen.</p></div><Gallery/></div></section>
  <section class="section timeline-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Our journey</div><h2>From one match to a movement.</h2></div></div><div class="timeline"><div><strong>2024</strong><span>First charity match</span><p>Manchester Select vs Great Britain Police, with the women’s fixture added to the day.</p></div><div><strong>£79,484</strong><span>Raised at the first event</span><p>Almost 1,000 fans came together to support The Christie.</p></div><div><strong>Today</strong><span>Community club</span><p>Growing the team, sponsorship and event programme from Aldwinians RUFC.</p></div><div><strong>Next</strong><span>More sport. More impact.</span><p>New events, new sports and more opportunities for people to get involved.</p></div></div></div></section>
  <section class="section next-chapter"><div class="container"><div class="eyebrow">The next chapter</div><h2>We're only getting started.</h2><div class="chapter-grid"><div><strong>01</strong><h3>More events</h3><p>A calendar of sporting events that keeps fundraising moving throughout the year.</p></div><div><strong>02</strong><h3>More sports</h3><p>Open Manchester Select to new sporting communities beyond rugby league.</p></div><div><strong>03</strong><h3>More people</h3><p>Give players, families, volunteers and businesses more ways to get involved.</p></div></div></div></section>
  <section id="sponsorship" class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Choose your impact</div><h2>Put your brand behind the cause.</h2></div><p class="lead" style="max-width:370px">Choose a sponsorship level and help us fund the next Manchester Select event. Every package contributes to our fundraising mission.</p></div><div class="sponsor-grid">{tiers.map((tier,index)=><article class:list={['sponsor-card',index===0&&'featured']}><div class="eyebrow">Manchester Select</div><h3>{tier[0]}</h3><div class="price">{tier[1]}</div><p>{tier[2]}</p><a class="button" class:button-accent={index===0} class:button-dark={index!==0} href="#contact">Enquire</a></article>)}</div><div class="sponsor-cta"><strong>Want to make a bigger impact?</strong><a href="#contact">Talk to us about a bespoke partnership →</a></div></div></section>
  <section id="contact" class="contact section"><div class="container story-grid"><div><div class="eyebrow">Get involved</div><h2>Bring your business, team or energy.</h2><p class="lead">There’s a place for everyone: sponsor, volunteer, play, attend or donate. Send us a message and we’ll help you find the right way in.</p><div class="involve-list"><a href="#sponsorship"><strong>SPONSOR</strong><span>Put your business behind the cause →</span></a><a href="/sports"><strong>PLAY</strong><span>Bring your team or sport →</span></a><a href="#events"><strong>ATTEND</strong><span>Come to the next event →</span></a></div><p class="form-note">Your enquiry is protected by Cloudflare Turnstile. We never sell your information.</p></div><form class="form-grid" method="post" action="/api/contact"><div class="field"><label for="name">Name</label><input id="name" name="name" required autocomplete="name"/></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="email" required autocomplete="email"/></div><div class="field"><label for="tier">Interested in</label><select id="tier" name="tier"><option value="">Choose a sponsorship tier</option>{tiers.map((tier)=><option value={tier[0]}>{tier[0]} — {tier[1]}</option>)}<option value="Other">Something else</option></select></div><div class="field"><label for="message">Message</label><textarea id="message" name="message" required></textarea></div><div class="field full"><div class="cf-turnstile" data-sitekey={turnstileKey}></div><input type="hidden" name="turnstile_token" id="turnstile-token"/><button class="button button-dark" type="submit">Send enquiry</button></div></form></div></section>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    const counters=document.querySelectorAll('[data-count]');
    const countUp=(el)=>{const target=Number(el.dataset.count);const prefix=target===85000?'£':'';const suffix=target===85000?'k+':target===1400?'':' ';let start=0;const duration=1000;const step=timestamp=>{if(!el.dataset.start)el.dataset.start=timestamp;const progress=Math.min((timestamp-Number(el.dataset.start))/duration,1);start=Math.floor(progress*target);el.textContent=target===85000?'£'+Math.round(start/1000)+'k+':target===1400?start.toLocaleString():'2';if(progress<1)requestAnimationFrame(step);else delete el.dataset.start};requestAnimationFrame(step)};
    const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting&&!e.target.dataset.done){e.target.dataset.done='1';countUp(e.target)}}),{threshold:.4});counters.forEach(c=>observer.observe(c));
  </script>
  <style>
    .hero-stats{display:flex;align-items:center;gap:14px;margin-top:30px;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.hero-stats i{width:4px;height:4px;background:var(--accent);border-radius:50%}.sport-preview{background:#f0eee8}.sport-preview-grid{display:grid;grid-template-columns:1.35fr 1fr 1fr;grid-template-rows:260px 260px;gap:14px;margin-bottom:28px}.sport-preview-card{position:relative;border-radius:22px;overflow:hidden;background:var(--navy);color:#fff}.sport-preview-card:first-child{grid-row:1/3}.sport-preview-card img{width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform .5s}.sport-preview-card:hover img{transform:scale(1.05)}.sport-preview-card>div{position:absolute;inset:auto 0 0;padding:25px;background:linear-gradient(transparent,rgba(0,0,0,.9))}.sport-preview-card span{display:block;font-size:1.8rem;font-weight:950}.sport-preview-card small{display:block;color:#d8e0e4}.impact-story{background:var(--navy);color:#fff;padding:110px max(20px,calc((100vw - 1180px)/2));display:grid;grid-template-columns:1.15fr .85fr;gap:60px;align-items:center;overflow:hidden}.impact-story-number{font-size:clamp(6rem,15vw,13rem);font-weight:950;letter-spacing:-.09em;line-height:.78;color:var(--accent)}.impact-story-copy h2{font-size:clamp(3rem,6vw,5.5rem);line-height:.9;letter-spacing:-.06em;margin:0 0 25px}.impact-story-copy p{color:#ccd5da;max-width:520px;font-size:1.1rem}.people-section{background:#fff}.people-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.people-grid article{padding:34px 24px;min-height:240px;border-right:1px solid var(--line)}.people-grid article:last-child{border-right:0}.people-grid span,.chapter-grid strong{color:#a4bb17;font-weight:950}.people-grid h3{font-size:2rem;margin:35px 0 8px}.people-grid p,.chapter-grid p{color:#61707d}.partner-wall{margin-top:70px;text-align:center}.partner-wall>.eyebrow{color:#61707d}.partner-wall .partner-row{margin-top:22px}.partner-wall p{margin-top:22px;color:#61707d}.partner-wall a{font-weight:900;color:var(--navy)}.timeline{display:grid;grid-template-columns:repeat(4,1fr);border-top:2px solid var(--navy);position:relative}.timeline>div{padding:28px 25px 10px;border-right:1px solid var(--line);position:relative}.timeline>div:last-child{border-right:0}.timeline>div:before{content:"";width:12px;height:12px;background:var(--accent);border:3px solid var(--navy);border-radius:50%;position:absolute;top:-8px;left:24px}.timeline strong{display:block;font-size:2.2rem;letter-spacing:-.05em}.timeline span{font-weight:900;text-transform:uppercase;font-size:.72rem;letter-spacing:.08em}.timeline p{color:#61707d}.next-chapter{background:#d9f24f}.next-chapter h2{max-width:760px;font-size:clamp(3.5rem,8vw,7rem);line-height:.86;margin:15px 0 55px}.chapter-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(7,18,29,.18)}.chapter-grid>div{background:#d9f24f;padding:30px 24px;min-height:210px;border-right:1px solid rgba(7,18,29,.18)}.chapter-grid h3{font-size:1.7rem;margin:35px 0 5px}.sponsor-cta{margin-top:28px;padding:22px 25px;background:#e9ecec;border-radius:18px;display:flex;justify-content:space-between;gap:20px;align-items:center}.sponsor-cta a{font-weight:900}.involve-list{margin:28px 0;display:grid;gap:1px;border-top:1px solid #cbd3d8}.involve-list a{padding:15px 0;border-bottom:1px solid #cbd3d8;display:flex;justify-content:space-between;gap:15px}.involve-list span{color:#61707d;font-size:.9rem}.sport-hero{background:var(--navy);color:#fff;padding:170px 0 105px}.sport-hero h1{font-size:clamp(4.5rem,10vw,9rem);line-height:.82;letter-spacing:-.08em;margin:0 0 35px}.sport-hero h1 span{color:var(--accent)}.sport-hero .lead{max-width:700px;color:#d3dce1}.sports-grid{display:grid;grid-template-columns:1.5fr 1fr;grid-auto-rows:380px;gap:16px}.sport-card{position:relative;overflow:hidden;border-radius:24px;background:var(--navy);color:#fff}.sport-card-large{grid-row:span 2}.sport-card>img{width:100%;height:100%;object-fit:cover;opacity:.7;transition:transform .5s}.sport-card:hover>img{transform:scale(1.05)}.sport-card-overlay{position:absolute;inset:auto 0 0;padding:30px;background:linear-gradient(transparent,rgba(0,0,0,.92))}.sport-card h3{font-size:clamp(2rem,4vw,3.5rem);line-height:.9;margin:5px 0 12px}.sport-card p{max-width:560px;color:#d3dce1}.sports-purpose{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.sports-purpose h2{font-size:clamp(3rem,6vw,5.5rem);line-height:.9;letter-spacing:-.06em}.chapter-grid>div{min-height:230px}
    @media(max-width:900px){.hero-stats{flex-wrap:wrap}.sport-preview-grid{grid-template-columns:1fr 1fr;grid-template-rows:240px 240px}.sport-preview-card:first-child{grid-row:auto;grid-column:1/3}.impact-story{grid-template-columns:1fr;padding:85px 20px}.impact-story-number{font-size:clamp(5rem,18vw,9rem)}.people-grid{grid-template-columns:1fr 1fr}.people-grid article:nth-child(2){border-right:0}.timeline{grid-template-columns:1fr 1fr}.timeline>div:nth-child(2){border-right:0}.timeline>div:nth-child(3){border-top:1px solid var(--line)}.timeline>div:nth-child(4){border-top:1px solid var(--line)}.chapter-grid{grid-template-columns:1fr}.sponsor-cta{display:grid}.sports-grid{grid-template-columns:1fr;grid-auto-rows:340px}.sport-card-large{grid-row:auto}.sports-purpose{grid-template-columns:1fr;gap:20px}}
    @media(max-width:560px){.hero-stats{display:grid;gap:7px}.hero-stats i{display:none}.sport-preview-grid{display:grid;grid-template-columns:1fr;grid-template-rows:260px 200px 200px 200px}.sport-preview-card:first-child{grid-column:auto}.people-grid{grid-template-columns:1fr}.people-grid article{border-right:0!important;border-bottom:1px solid var(--line)}.people-grid article:last-child{border-bottom:0}.timeline{grid-template-columns:1fr}.timeline>div{border-right:0!important;border-top:1px solid var(--line)!important}.timeline>div:first-child{border-top:0!important}.timeline>div:before{display:none}.sport-hero{padding:130px 0 75px}.sport-hero h1{font-size:4.5rem}.sport-card-overlay{padding:22px}.impact-story-copy h2{font-size:3.4rem}}
  </style>
</Layout>
