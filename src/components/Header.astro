---
const logo = 'https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/logo.png';
const donateUrl = 'https://www.zeffy.com/en-GB/donation-form/christie-cup-donations';
const isHome = Astro.url.pathname === '/';
---
<header class:list={['site-header', { 'site-header-home': isHome }]} id="site-header">
  <nav class="nav-shell" aria-label="Main navigation">
    <a href="/" class="brand" aria-label="Manchester Select home"><img src={logo} alt="Manchester Select" /></a>
    <button class="menu-button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
    <div class="desktop-nav">
      <a href="/events">Upcoming Events</a>
      <a href="/sports">Sports</a>
      <a href="/our-story">Our Story</a>
      <a href="/#impact">Impact</a>
      <a href="/#sponsorship">Sponsorship</a>
      <a href={donateUrl} target="_blank" rel="noreferrer" class="nav-cta nav-donate">Donate</a>
      <a href="/#contact" class="nav-cta">Get Involved</a>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <a href="/events">Upcoming Events</a><a href="/sports">Sports</a><a href="/our-story">Our Story</a><a href="/#impact">Impact</a><a href="/#sponsorship">Sponsorship</a><a href={donateUrl} target="_blank" rel="noreferrer">Donate</a><a href="/#contact">Get Involved</a>
  </div>
</header>
<script>
  const button = document.querySelector('.menu-button');
  const menu = document.querySelector('#mobile-menu');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
<style>
  .nav-donate{background:var(--navy);color:#fff}
  .site-header-home .nav-donate{background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.4)}
</style>
