---
const options=[['Player sponsorship','£50','Back an individual player and help keep the community at the heart of the event.'],['Shorts sponsorship','£250','Put your business on the matchday journey and support the squad.'],['Small shirt sponsorship','£400','A visible sponsorship position supporting the next event.'],['Ball sponsorship','£500','Put your brand at the heart of the matchday experience.'],['Large shirt / tournament sponsorship','£1,000','Premium visibility across the tournament and event materials.']];
---
<section class="sponsor-calculator"><div class="calculator-copy"><div class="eyebrow">Choose your impact</div><h2>How do you want to show up?</h2><p>Pick a level to see the kind of support you can put behind Manchester Select.</p></div><div class="calculator-options">{options.map((option,index)=><button type="button" class:list={{active:index===0}} data-price={option[1]} data-copy={option[2]}><strong>{option[1]}</strong><span>{option[0]}</span></button>)}</div><div class="calculator-result"><span>YOUR SUPPORT</span><strong id="calculator-price">£50</strong><p id="calculator-copy">Back an individual player and help keep the community at the heart of the event.</p><a class="button button-dark" href="/#contact">Start an enquiry →</a></div></section>
<script>
  const buttons=document.querySelectorAll<HTMLButtonElement>('.sponsor-calculator button');
  const price=document.querySelector('#calculator-price'); const copy=document.querySelector('#calculator-copy');
  buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(item=>item.classList.remove('active'));button.classList.add('active');if(price)price.textContent=button.dataset.price||'';if(copy)copy.textContent=button.dataset.copy||'';}));
</script>
<style>
.sponsor-calculator{margin-top:55px;background:#d9f24f;border-radius:28px;padding:42px;display:grid;grid-template-columns:1fr 1.2fr;gap:35px}.calculator-copy h2{font-size:clamp(2.5rem,5vw,4.5rem);line-height:.9;letter-spacing:-.06em;margin:8px 0 15px}.calculator-copy p{max-width:450px;color:#34424b}.calculator-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.calculator-options button{text-align:left;border:1px solid rgba(7,18,29,.18);background:rgba(255,255,255,.35);border-radius:16px;padding:17px;cursor:pointer;color:#07121d}.calculator-options button.active{background:#07121d;color:#fff}.calculator-options strong{display:block;font-size:1.5rem}.calculator-options span{display:block;font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em;margin-top:4px}.calculator-result{grid-column:1/-1;background:#fff;border-radius:20px;padding:25px;display:flex;align-items:center;gap:25px}.calculator-result>span{font-size:.7rem;font-weight:950;letter-spacing:.1em}.calculator-result>strong{font-size:2.8rem;letter-spacing:-.06em}.calculator-result p{margin:0;flex:1;color:#61707d}.calculator-result .button{white-space:nowrap}@media(max-width:800px){.sponsor-calculator{grid-template-columns:1fr;padding:28px}.calculator-result{display:grid;grid-template-columns:auto auto}.calculator-result p{grid-column:1/-1}.calculator-result .button{grid-column:1/-1}}@media(max-width:560px){.calculator-options{grid-template-columns:1fr}.calculator-result{gap:10px}.calculator-result>strong{font-size:2.2rem}}
</style>
