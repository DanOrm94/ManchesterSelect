---
const logo = 'https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/logo.png';
const donateUrl = 'https://www.zeffy.com/en-GB/donation-form/christie-cup-donations';
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <img class="footer-logo" src={logo} alt="Manchester Select" />
      <p class="footer-copy">Sport with purpose. A Manchester charity bringing athletes, clubs, businesses and supporters together to raise money for The Christie.</p>
      <div class="footer-contact">
        <h3>Contact</h3>
        <address>
          Globe House<br />
          Globe Lane<br />
          Dukinfield<br />
          Greater Manchester<br />
          SK16 4RG
        </address>
        <a href="mailto:info@mcrselect.co.uk">info@mcrselect.co.uk</a>
      </div>
      <div class="footer-social">
        <h3>Follow us</h3>
        <div class="social-icons">
          <a href="https://www.instagram.com/mcrselectrugby/" target="_blank" rel="noreferrer" aria-label="Manchester Select on Instagram">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.62c-3.15 0-3.52.01-4.76.07-1.15.05-1.77.24-2.19.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.42-.35 1.04-.4 2.19-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.05 1.15.24 1.77.4 2.19.22.55.47.94.88 1.35.41.41.8.66 1.35.88.42.16 1.04.35 2.19.4 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c1.15-.05 1.77-.24 2.19-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.42.35-1.04.4-2.19.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.05-1.15-.24-1.77-.4-2.19a3.64 3.64 0 0 0-.88-1.35 3.64 3.64 0 0 0-1.35-.88c-.42-.16-1.04-.35-2.19-.4-1.24-.06-1.61-.07-4.76-.07Zm0 2.76a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6Zm0 1.62a3.68 3.68 0 1 0 0 7.36 3.68 3.68 0 0 0 0-7.36Zm5.5-2.9a1.24 1.24 0 1 1 0 2.48 1.24 1.24 0 0 1 0-2.48Z"/></svg>
          </a>
          <a href="https://www.facebook.com/people/Manchester-Select-Charity-Rugby-League/61562008773283/" target="_blank" rel="noreferrer" aria-label="Manchester Select on Facebook">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div><h3>Explore</h3><a href="/sports">Sports</a><a href="/#our-story">Our Story</a><a href="/#impact">Impact</a><a href="/#events">Events</a><a href="/#sponsorship">Sponsorship</a></div>
    <div><h3>Policies</h3><a href="/privacy-cookies-policy">Privacy & Cookies</a><a href="/fundraising-policy">Fundraising Policy</a><a href="/volunteer-policy">Volunteer Policy</a></div>
    <div><h3>Get involved</h3><a href={donateUrl} target="_blank" rel="noreferrer">Donate</a><a href="/#contact">Sponsor an event</a><a href="/#contact">Volunteer</a><a href="/#contact">Play for Manchester Select</a><a href="/#contact">Bring a new sport</a></div>
  </div>
  <div class="container footer-bottom"><span>© 2026 Manchester Select</span><span>Sport for community. Sport for good.</span></div>
  <a class="mobile-sticky-cta" href="/#contact">Support Manchester Select <span>→</span></a>
</footer>
<style>
.mobile-sticky-cta{display:none}
.footer-contact{margin-top:24px}
.footer-contact address{font-style:normal;line-height:1.7;margin:0 0 10px;color:rgba(255,255,255,.7);font-size:.9rem}
.footer-contact a{display:inline-block;color:#fff;font-size:.9rem;font-weight:700}
.footer-social{margin-top:24px}
.social-icons{display:flex;gap:12px;margin-top:12px}
.social-icons a{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:999px;border:1px solid rgba(255,255,255,.2);color:#fff;transition:color .2s ease,border-color .2s ease,transform .2s ease,background-color .2s ease}
.social-icons a:hover{color:var(--navy);background:var(--accent);border-color:var(--accent);transform:translateY(-2px)}
@media(prefers-reduced-motion:reduce){.social-icons a{transition:color .2s ease,background-color .2s ease,border-color .2s ease}.social-icons a:hover{transform:none}}
@media(max-width:700px){.mobile-sticky-cta{display:flex;position:fixed;z-index:45;left:12px;right:12px;bottom:12px;background:#d9f24f;color:#07121d;border-radius:999px;padding:13px 18px;align-items:center;justify-content:space-between;font-size:.8rem;font-weight:950;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 12px 30px rgba(0,0,0,.18)}body{padding-bottom:70px}}
</style>
