---
import '../styles/global.css';
import '../styles/story-fix.css';
import '../styles/people.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
const { title = 'Manchester Select | Sport for good', description = 'Manchester Select brings people together through rugby league and community events to raise money for The Christie.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://mcrselect.co.uk');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://raw.githubusercontent.com/DanOrm94/ManchesterSelect/main/Supporting-The-Christie-Charity.jpg" />
    <meta name="theme-color" content="#07121d" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <CookieBanner />
  </body>
</html>
